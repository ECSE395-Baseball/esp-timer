CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_FREERTOS_HZ=1000

CONFIG_ETH_USE_OPENETH=y

# The Feather ESP32 V2 has 8MB of flash; matches the QEMU image size.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# esp32-camera has some weird I2C compat issues
# Tested and works fine
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Minimise bluetooth size due to small utilization
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=10
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=8
CONFIG_BT_NIMBLE_MAX_BONDS=1

# Pin camera core and minimise build for smaller utilization
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_CAMERA_CORE1=y
CONFIG_CAMERA_TASK_STACK_SIZE=3072

# Closed source blobs have a bug with the coexist scheduler
# we disabled it, tested and works fine
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n

# overclock: QR decoding takes a lot of cycles for
# several hundred ms per frame; this makes scanning faster
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
